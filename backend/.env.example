# 会社設立申請書自動入力 API - 環境変数サンプル
# コピー: cp .env.example .env のあと、値を設定してください。
# .env は git にコミットしないでください。

# === 必須（現在の仕様で必要） ===
# GoogleサービスアカウントJSONへのパス（ローカルでは相対パス、RenderではSecret Fileのパス）
GOOGLE_DRIVE_CREDENTIALS_PATH=./companyestablishsupport-a633c02517ff.json
# 生成ファイルをアップロードする親フォルダのID（1つの会社用フォルダ）
GOOGLE_DRIVE_FOLDER_ID=
# 申請内容を書き込むスプレッドシートのID
GOOGLE_SHEETS_SPREADSHEET_ID=

# === 任意（追加連携用） ===
# ひらがな/カタカナ変換や翻訳APIを使う場合のみ設定
GOOGLE_TRANSLATE_API_KEY=
# Google Maps連携機能を使う場合のみ設定
GOOGLE_MAPS_API_KEY=

# === OpenAI（任意）===
# カタカナ変換（単語だけ出力 + フォールバック）に使う場合のみ設定
OPENAI_API_KEY=
OPENAI_KATAKANA_MODEL=gpt-4o-mini

# === Slack（任意） ===
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_USER_ID=

# === Google Drive / Sheets（任意） ===
# サービスアカウント JSON のパス（Render では Secret File のパスを指定）
GOOGLE_DRIVE_CREDENTIALS_PATH=./companyestablishsupport-a633c02517ff.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# === その他 ===
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# テンプレート保存先（未設定時は backend のカレントディレクトリ）
# TEMPLATE_DIR=
