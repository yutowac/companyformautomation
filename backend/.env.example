# 会社設立申請書自動入力 API - 環境変数サンプル
# コピー: cp .env.example .env のあと、値を設定してください。
# .env は git にコミットしないでください。

# === 必須（現在の仕様で必要） ===
# GoogleサービスアカウントJSONへのパス（ローカルでは相対パス、RenderではSecret Fileのパス）
GOOGLE_DRIVE_CREDENTIALS_PATH=./companyestablishsupport-a633c02517ff.json
# 生成ファイルをアップロードする親フォルダのID（1つの会社用フォルダ）
GOOGLE_DRIVE_FOLDER_ID=
# 申請内容を書き込むスプレッドシートのID
GOOGLE_SHEETS_SPREADSHEET_ID=

# === 任意（追加連携用） ===
# ひらがな/カタカナ変換や翻訳APIを使う場合のみ設定
GOOGLE_TRANSLATE_API_KEY=
# Google Maps連携機能を使う場合のみ設定
GOOGLE_MAPS_API_KEY=

# === OpenAI（任意）===
# カタカナ変換（単語だけ出力 + フォールバック）に使う場合のみ設定
OPENAI_API_KEY=
OPENAI_KATAKANA_MODEL=gpt-4o-mini

# === Slack（任意） ===
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_USER_ID=

# === Google Drive OAuth（アップロード用。Render / 本番で必須） ===
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# === ログイン・申請保存（PostgreSQL 必須）===
# ローカル Docker（リポジトリルートで docker compose up -d）の例:
DATABASE_URL=postgresql://app:app@localhost:5432/companyform
# Render では Dashboard の Internal Database URL を設定（Secret）
JWT_SECRET_KEY=local-dev-secret-change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 未申請のテストユーザー（起動時に未存在なら作成）
AUTH_TEST_EMAIL=test@example.com
AUTH_TEST_PASSWORD=testpassword123

# ローカル用サンプル（申請済みユーザー）。本番 Render では true にしないこと
SEED_SAMPLE_DATA=true
SAMPLE_APPLIED_EMAIL=applied@example.com
SAMPLE_APPLIED_PASSWORD=testpassword123

# Monthly Payment Requests → Sheets タブ名
GOOGLE_SHEETS_PAYMENT_SHEET=PaymentRequests
# ADMIN_API_KEY=

# === その他 ===
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# テンプレート保存先（未設定時は backend のカレントディレクトリ）
# TEMPLATE_DIR=
